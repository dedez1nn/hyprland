[Unit]
Description=Rclone Google Drive Mount
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/rclone mount drive: /home/andrelmi/drive \
	--vfs-cache-mode full \
	--buffer-size 64M \
	--dir-cache-time 72h
ExecStop=/usr/bin/fusermount -u /home/andrelmi/drive
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
